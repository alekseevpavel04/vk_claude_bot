# Куда деплоить. Скопируй в deploy/deploy.env и заполни.
# Файл в .gitignore — в репозиторий не попадёт.

VPS_HOST=203.0.113.10
VPS_USER=root
VPS_PORT=22

# Папка на сервере. Отдельная от всего остального — бот живёт только в ней.
REMOTE_DIR=/opt/vk_claude_bot

# Ключ для ssh, если он не подхватывается автоматически.
# SSH_KEY=~/.ssh/id_ed25519
