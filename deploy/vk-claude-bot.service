[Unit]
Description=VK <-> Claude bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claudebot
Group=claudebot
WorkingDirectory=/opt/vk_claude_bot
ExecStart=/opt/vk_claude_bot/.venv/bin/python -m bot.main
Environment=PYTHONUNBUFFERED=1
# Claude Code CLI ставится через npm — путь до node должен быть виден сервису.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

Restart=always
RestartSec=5s
# Если падает по кругу — не долбить бесконечно.
StartLimitIntervalSec=300
StartLimitBurst=10

# Ограничения: боту нужно писать только в свою папку и в ~/.claude,
# где CLI хранит транскрипты сессий.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/vk_claude_bot /home/claudebot

[Install]
WantedBy=multi-user.target
