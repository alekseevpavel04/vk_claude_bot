# --- ВКонтакте ---
# Ключ доступа сообщества: Управление -> Работа с API -> Ключи доступа.
# Нужны ЧЕТЫРЕ галочки сразу:
#   "Управление сообществом"   — без него ВК не отдаёт Long Poll, и бот вообще
#                                не увидит ни одного сообщения;
#   "Сообщения сообщества"     — читать и отвечать;
#   "Фотографии", "Документы"  — присылать картинки и файлы.
# Проверить всё разом: python -m scripts.check_setup
VK_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Числовой id сообщества (без минуса). Виден в адресе вида vk.com/club123456789
VK_GROUP_ID=123456789

# Кто имеет право писать боту. Свой id: vk.com/id... или через "Мой профиль".
# Несколько — через запятую. Пустое значение = бот не отвечает никому.
ALLOWED_USER_IDS=1234567

# --- Claude ---
# Токен подписки: на машине с браузером выполнить `claude setup-token`.
# Если Claude Code уже залогинен на этой машине (есть ~/.claude), строку можно
# закомментировать — SDK возьмёт креды из окружения.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно: явная модель. По умолчанию — модель Claude Code по умолчанию.
# CLAUDE_MODEL=claude-opus-5

# --- Поведение бота (всё необязательно, значения ниже — дефолтные) ---
# Сколько дней хранить скачанные из ВК вложения
# MEDIA_TTL_DAYS=7
# Через сколько часов молчания забывать контекст разговора (168 = неделя).
# Контекст копится с каждым ходом и стоит токенов; 0 — не забывать никогда.
# SESSION_TTL_HOURS=168
# Максимальный размер скачиваемого вложения, МБ
# MAX_ATTACHMENT_MB=20
# Потолок на всю папку вложений, МБ: при переполнении удаляются самые старые
# файлы. Диск на VPS общий с соседними сервисами, кончиться он не должен.
# MEDIA_MAX_TOTAL_MB=512
# Потолок шагов агента на один вопрос (защита от зацикливания). Десять фото
# с винной полки — это уже десяток чтений плюс поиск и ответ.
# MAX_TURNS=40
# Пауза перед ответом, секунды: всё, что пришло за неё, считается одним
# вопросом. Пересланное с телефона и комментарий к нему ВК шлёт двумя
# сообщениями подряд, и без паузы бот отвечает на них порознь. Несколько
# прикреплённых фотографий телефон тоже отправляет по мере загрузки, вразбивку
# на несколько секунд. 0 — отвечать сразу на каждое сообщение.
# MESSAGE_MERGE_SECONDS=5
# Показывать промежуточные вызовы инструментов (поиск, чтение файлов)
# SHOW_TOOL_PROGRESS=true
# Путь к Chromium, которым бот смотрит на сайты и снимает экран. В образе он
# уже стоит и задан; строка нужна разве что локально на Windows, где подойдёт
# установленный Chrome или Edge.
# CHROMIUM_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Прокси на всё, чем бот ходит в сеть: и браузер, и Vivino, и карточки
# Wildberries, и скачивание картинок. Нужен, только если хочется открывать
# сайты, закрывшиеся от адреса сервера: Ozon и прочие любители блокировать
# зарубежные дата-центры. Российский адрес снимает эти блокировки, зарубежный
# ничего не меняет. Формат: http://логин:пароль@адрес:порт
# HTTPS_PROXY=
# Отдельный прокси только для браузера — если ему нужен свой выход.
# По умолчанию браузер берёт HTTPS_PROXY выше.
# BROWSER_PROXY=
